{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Default mobile capability",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "sql:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*.supabase.co/auth/v1/authorize*"
        }
      ]
    }
  ]
}
