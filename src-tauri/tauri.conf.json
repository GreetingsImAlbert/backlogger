{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backlogger",
  "version": "0.1.0",
  "identifier": "local.backlogger.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Backlogger",
      "width": 520,
      "height": 800,
      "minWidth": 340,
      "minHeight": 420,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost https://*.supabase.co"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["backlogger"]
      }
    }
  },
  "bundle": {
    "active": true
  }
}
