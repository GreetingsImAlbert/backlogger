{
  "name": "backlogger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:dev": "set BACKLOGGER_DEV_HOST=0.0.0.0&& tauri android dev",
    "android:build": "tauri android build --debug --apk --target x86_64 --ci",
    "supabase:start": "npx supabase start",
    "supabase:reset:local": "npx supabase db reset --local",
    "supabase:test:db": "npx supabase test db --local",
    "supabase:types:local": "npx supabase gen types --lang typescript --local > supabase/database.types.ts",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5"
  }
}
